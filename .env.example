NODE_ENV=production
PORT=3500
PUBLIC_URL=https://upload.example.com
CORS_ORIGINS=https://app.example.com,https://staging.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=file_service_user
DB_PASS=change-me
DB_NAME=guaba_file_service
DB_POOL_SIZE=10
DB_MIGRATE=true

FILE_SERVICE_V1_ENABLED=true
LEGACY_UPLOAD_ENABLED=true
FILE_ADMIN_KEY=generate-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=generate-exactly-64-hex-characters
SIGNATURE_WINDOW_SECONDS=300

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/home/CPANEL_USER/guaba-file-storage
MAX_UPLOAD_BYTES=26214400
UPLOAD_SESSION_TTL_SECONDS=900
